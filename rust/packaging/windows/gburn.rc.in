1 ICON "@ICON@"
1 VERSIONINFO
FILEVERSION @V4@
PRODUCTVERSION @V4@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "GBurn"
      VALUE "FileDescription", "GBurn"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "gburn"
      VALUE "OriginalFilename", "gburn.exe"
      VALUE "ProductName", "GBurn"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
